# ─── invoice-me Environment Variables ────────────────────────────────────────
# Copy this file to .env.local for local development.
# Production values are set in Coolify dashboard — never commit them.

# ─── Application ─────────────────────────────────────────────────────────────

# Environment mode
NODE_ENV=development

# Public base URL of the app
APP_URL=http://localhost:3000

# Host port mapping (Docker)
APP_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Dev: docker compose -f docker-compose.dev.yml up -d first
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_me?schema=public

# ─── Authentication (Better Auth) ─────────────────────────────────────────────

# Session signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Base URL for auth callbacks (same as APP_URL in most cases)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins Better Auth trusts for Origin-checked POSTs
# (sign-out and friends). Add every front door the app is reached through:
# LAN IP, SSH tunnel, reverse proxy. Without them those POSTs answer
# INVALID_ORIGIN ("Gagal keluar, sesi belum berakhir").
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── PDF Service ──────────────────────────────────────────────────────────────

# Shared secret for signing requests from app → pdf-service
# Generate with: openssl rand -base64 32
INTERNAL_PDF_SECRET=change-me-generate-with-openssl-rand-base64-32

# Internal URL pdf-service uses to fetch print route from app
# Host-to-host dev (npm run dev + node pdf-service): http://localhost:3000
# Docker compose overrides this to http://app:3000
INTERNAL_APP_URL=http://localhost:3000

# URL the app's PdfJob worker uses to reach pdf-service (POST /render)
# Use 3090 locally if 3001 is taken by another process on your machine;
# docker compose overrides this to http://pdf-service:3001
PDF_SERVICE_URL=http://localhost:3090

# Run the PdfJob poller inside the app process (single instance MVP)
PDF_WORKER_ENABLED=true

# ─── Storage ──────────────────────────────────────────────────────────────────

# Root directory for file storage (uploads + generated PDFs)
# Dev: ./.data   Production: /data (Docker volume)
STORAGE_ROOT=./.data

# Maximum upload file size in MB
UPLOAD_MAX_MB=2

# ─── Localization ─────────────────────────────────────────────────────────────

DEFAULT_TIMEZONE=Asia/Jakarta

# ─── Seed (super admin — dev/acceptance only) ─────────────────────────────────

SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=admin@example.test
# Generate: openssl rand -base64 16
SEED_ADMIN_PASSWORD=change-me-seed-password

# ─── Bank Account Encryption ──────────────────────────────────────────────────

# AES-256-GCM key for encrypting bank account numbers at rest
# Generate: openssl rand -base64 32
BANK_ACCOUNT_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ─── Error Tracking (GlitchTip — optional) ────────────────────────────────────

# Self-hosted GlitchTip DSN. Leave empty to disable error tracking.
GLITCHTIP_DSN=

# ─── Cloudflare Tunnel (optional) ─────────────────────────────────────────────

# Tunnel token from Cloudflare dashboard.
# Only used when docker compose --profile cloudflared up
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Backup and restore (scripts only — not read by the app) ─────────────────
# Full documentation: README "Backup and restore".

# Where backup directories are written (scripts only — not read by the app).
# Mount this as a persistent volume; on the same disk as the DB/uploads it is
# NOT a final backup — also set BACKUP_EXTERNAL_PATH.
#BACKUP_DEST=/backups

# Delete backups older than N days on each successful run (minimum 1)
#BACKUP_RETENTION_DAYS=30

# Optional second copy of every backup (NAS/external mount) — same-disk
# backups are not a final backup. Set this to a directory on ANOTHER device.
#BACKUP_EXTERNAL_PATH=/mnt/nas/invoice-me-backups

# Postgres container for the docker-exec tool fallback (auto-detected when unset)
#PG_CONTAINER=invoice-me-postgres-1

# Full command overrides for the PostgreSQL tools when they live somewhere
# unusual (scripts resolve: override → host PATH → docker exec fallback)
#PG_DUMP_BIN=pg_dump
#PG_RESTORE_BIN=pg_restore
#PSQL_BIN=psql

# Isolated database restore.sh proves a dump into before touching the real one
#RESTORE_TEST_DATABASE=invoice_me_restore_check
