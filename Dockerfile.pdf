FROM node:22-bookworm-slim AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 pdfservice

# Copy pre-installed node_modules from build context.
# Full Playwright Chromium setup is added in feature 06.
COPY pdf-service/node_modules ./node_modules
COPY pdf-service/src ./src
COPY pdf-service/package.json ./

# docker-entrypoint.sh hands the mounted STORAGE_ROOT volume (root-owned on
# first mount) to the pdfservice user, then drops privileges with setpriv, which
# is already in the base image — no apt install (build containers have no DNS).
COPY pdf-service/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER root

EXPOSE 3001
ENV PORT=3001

CMD ["docker-entrypoint.sh"]
