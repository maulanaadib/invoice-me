{
  "framework": "vitest",
  "addons": ["playwright"],
  "unit": {
    "runner": "vitest",
    "command": "npm run test"
  },
  "integration": {
    "runner": "vitest",
    "command": "npm run test -- tests/integration",
    "requires": "TEST_DATABASE_URL (test postgres)"
  },
  "e2e": {
    "runner": "playwright",
    "command": "npm run test:e2e"
  },
  "source": "context/testing-standards.md"
}
