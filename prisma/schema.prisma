// Prisma schema — feature 00 baseline + feature 01 auth/multi-tenant.
// Business entities (Invoice, Customer, etc.) are added per-feature via migration.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Platform enums ───────────────────────────────────────────────────────────

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

// Audit actions. The canonical admin-facing list is finalized in feature 11
// (see context/data-model.md). USER_ACTIVATED / SESSION_REVOKED / PASSWORD_CHANGED
// added in feature 01 because feature 01 performs those audited actions.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  USER_CREATED
  USER_SUSPENDED
  USER_ACTIVATED
  PASSWORD_RESET
  PASSWORD_CHANGED
  SESSION_REVOKED
  ORGANIZATION_CREATED
  MEMBERSHIP_CHANGED
  PROFILE_CHANGED
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  INVOICE_DRAFT_CREATED
  INVOICE_UPDATED
  INVOICE_ISSUED
  PDF_GENERATED
  PDF_DOWNLOADED
  INVOICE_SENT
  INVOICE_CANCELLED
  INVOICE_REVISED
  PAYMENT_RECORDED
  ADMIN_VIEWED_INVOICE
}

// ─── Better Auth core models ──────────────────────────────────────────────────

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Platform fields
  username          String?      @unique
  platformRole      PlatformRole @default(USER)
  mustChangePassword Boolean     @default(false)
  status            UserStatus   @default(ACTIVE)

  // Feature 02: onboarding wizard state. onboardingStep tracks resume position
  // (1..12); onboardingComplete flips true only when the wizard finishes.
  onboardingComplete Boolean     @default(false)
  onboardingStep      Int         @default(1)

  // Better Auth admin plugin fields (kept in sync with platformRole:
  // SUPER_ADMIN -> "admin", USER -> "user"; Better Auth's hasPermission reads
  // this column to authorize admin plugin endpoints).
  role       String?
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  accounts    account[]
  sessions    session[]
  memberships Membership[]
  auditLogs   AuditLog[]
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  // Feature 05: who issued an invoice / generated an official PDF.
  invoicesIssued Invoice[]    @relation("InvoiceIssuedBy")
  pdfsGenerated  InvoicePdf[] @relation("InvoicePdfGeneratedBy")

  @@map("user")
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth admin plugin field
  impersonatedBy String?
  // Active workspace (feature 01): written server-side only after the
  // membership is verified; every scoped read re-validates the membership.
  activeOrganizationId String?

  @@map("session")
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Feature 01: auth & multi-tenant ──────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  profiles    InvoiceProfile[]
  bankAccounts BankAccount[]
  signers     Signer[]
  customers        Customer[]
  projectReferences ProjectReference[]
  invoices         Invoice[]

  @@map("Organization")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  permissions    Json?
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("Membership")
}

model AuditLog {
  id             String      @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         AuditAction
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  actor        user?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("AuditLog")
}

// ─── Feature 02: onboarding & invoice profile ─────────────────────────────────
// Field names, enums and constraints follow context/data-model.md (canonical).

enum SequenceResetPolicy {
  MONTHLY
  YEARLY
  NEVER
}

enum TaxMode {
  NONE
  INCLUSIVE
  EXCLUSIVE
  // Feature 04: manual tax amount input (canonical enum in context/data-model.md).
  MANUAL
}

enum StampMode {
  NONE
  E_METERAI
  PHYSICAL
  BLANK_SPACE
}

model InvoiceProfile {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  legalName      String?
  logoPath       String?
  primaryColor   String    @default("#2563eb")
  address        String?
  phone          String?
  whatsapp       String?
  fax            String?
  email          String?
  website        String?
  taxId          String?

  defaultBankAccountId String?
  defaultSignerId      String?

  numberPattern       String              @default("INV/{CODE}/{ROMAN_MONTH}/{YYYY}/{SEQ:3}")
  sequenceResetPolicy SequenceResetPolicy @default(YEARLY)
  defaultCurrency     String              @default("IDR")
  defaultTaxMode      TaxMode             @default(NONE)
  defaultTaxPercent   Decimal?            @db.Decimal(5, 2)
  defaultStampMode    StampMode           @default(NONE)
  defaultNotes        String?
  templateKey         String              @default("corporate-blue")
  settings            Json?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultBankAccount BankAccount?       @relation("ProfileDefaultBank", fields: [defaultBankAccountId], references: [id], onDelete: SetNull)
  defaultSigner      Signer?            @relation("ProfileDefaultSigner", fields: [defaultSignerId], references: [id], onDelete: SetNull)
  bankAccounts       BankAccount[]      @relation("ProfileBankAccounts")
  sequences          InvoiceSequence[]
  invoices           Invoice[]

  @@unique([organizationId, code])
  @@map("InvoiceProfile")
}

model BankAccount {
  id                     String   @id @default(cuid())
  organizationId         String
  profileId              String?
  bankName               String
  bankCode               String?
  accountNumberEncrypted String // AES-256-GCM ciphertext: iv:tag:ciphertext (hex)
  accountNumberLast4     String
  accountHolder          String
  branch                  String?
  currency               String   @default("IDR")
  isDefault              Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile             InvoiceProfile? @relation("ProfileBankAccounts", fields: [profileId], references: [id], onDelete: SetNull)
  defaultForProfiles  InvoiceProfile[] @relation("ProfileDefaultBank")
  invoices            Invoice[]

  @@map("BankAccount")
}

model Signer {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  title              String?
  location           String?
  signatureImagePath String?
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultForProfiles   InvoiceProfile[] @relation("ProfileDefaultSigner")
  invoices             Invoice[]

  @@map("Signer")
}

// ─── Feature 03: customers & projects/PO ───────────────────────────────────
// Field names, enums and constraints follow context/data-model.md (canonical).

enum ReferenceType {
  PURCHASE_ORDER
  SPK
  CONTRACT
  QUOTATION
  OTHER
  NONE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  companyName    String
  legalName      String?
  businessType   String?
  // NPWP — PII: never written to logs or audit metadata (security-standards).
  taxId          String?
  address        String?
  city           String?
  province       String?
  postalCode     String?
  country        String?
  phone          String?
  whatsapp       String?
  email          String?
  notes          String?
  isActive       Boolean   @default(true)
  // Soft delete: only Customer has this (data-model rule). Rows are kept for
  // the audit trail; reads/lists filter on deletedAt.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts          CustomerContact[]
  projectReferences ProjectReference[]
  invoices          Invoice[]

  @@index([organizationId, companyName])
  @@map("Customer")
}

model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  title      String?
  division   String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([customerId, isPrimary])
  @@map("CustomerContact")
}

model ProjectReference {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String
  referenceType   ReferenceType
  referenceNumber String
  referenceDate   DateTime?
  title           String
  description     String?
  workValue       Decimal       @db.Decimal(18, 2)
  currency        String        @default("IDR")
  startDate       DateTime?
  endDate         DateTime?
  status          ProjectStatus @default(ACTIVE)
  attachmentPath  String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: a project row is business history — never removed with the
  // customer behind its back (customers are soft-deleted anyway).
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([organizationId, referenceNumber])
  @@map("ProjectReference")
}

// Sequence counters for {SEQ}, allocated at issue time (feature 06).
// sequenceKey example: "2026-VII" (year + roman month, depends on reset policy).
model InvoiceSequence {
  id               String   @id @default(cuid())
  invoiceProfileId String
  sequenceKey      String
  currentValue     Int      @default(0)
  updatedAt        DateTime @updatedAt

  invoiceProfile InvoiceProfile @relation(fields: [invoiceProfileId], references: [id], onDelete: Cascade)

  @@unique([invoiceProfileId, sequenceKey])
  @@map("InvoiceSequence")
}

// ─── Feature 04: invoice engine core + feature 05 lifecycle ───────────────
// Field names, enums and constraints follow context/data-model.md (canonical).

enum InvoiceType {
  DOWN_PAYMENT
  SETTLEMENT
  FULL
  TERM
  CUSTOM
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REVISED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  profileId      String
  customerId     String
  customerContactId String?
  projectReferenceId String?
  invoiceType    InvoiceType
  status         InvoiceStatus @default(DRAFT)
  // Final number — allocated at issue time (feature 05); null while DRAFT.
  number         String?
  // Temporary number rendered from the pattern while the invoice is a draft.
  numberPreview  String?
  invoiceDate    DateTime
  dueDate        DateTime?
  referenceType  ReferenceType?
  referenceNumber String?
  referenceDate  DateTime?
  paymentTerms   String?
  currency       String        @default("IDR")

  // Money: Decimal(18,2) end to end (architecture invariants 1 & 2) — the
  // server recalculates every derived amount on save; client totals are
  // display-only.
  workValue        Decimal  @db.Decimal(18, 2)
  workValueOverride Boolean @default(false)
  workValueReason  String?  @db.Text
  itemsSubtotal    Decimal  @db.Decimal(18, 2)
  previouslyBilled Decimal  @default(0) @db.Decimal(18, 2)
  billingPercent   Decimal? @db.Decimal(5, 2)
  billingMode      BillingMode @default(PERCENT)
  billingAmount    Decimal? @db.Decimal(18, 2)
  billingBase      Decimal  @db.Decimal(18, 2)
  // DOWN_PAYMENT / TERM labels ("DOWN PAYMENT 50%", "TERMIN 2 — 40%").
  termName         String?
  termNumber       Int?
  customLabel      String?
  customReason     String?  @db.Text
  discountAmount   Decimal  @default(0) @db.Decimal(18, 2)
  additionalAmount Decimal  @default(0) @db.Decimal(18, 2)
  taxMode          TaxMode   @default(NONE)
  taxPercent       Decimal?  @db.Decimal(5, 2)
  taxAmount        Decimal   @default(0) @db.Decimal(18, 2)
  roundingAmount   Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal   @db.Decimal(18, 2)
  amountPaid       Decimal   @default(0) @db.Decimal(18, 2)
  notes            String?   @db.Text
  footerText       String?   @db.Text
  stampMode        StampMode @default(NONE)
  signerId         String?
  bankAccountId    String?

  // ─── Feature 05: issue & lifecycle ───────────────────────────────────────
  // Issue metadata: written together with `number` + status inside the issue
  // transaction (issue-service). issuedById references the user who issued.
  issuedAt          DateTime?
  issuedById        String?
  cancelledAt       DateTime?
  cancellationReason String?  @db.Text
  // Revision links: new draft.revisedFromId → old invoice; old.replacedById →
  // new draft (both SetNull — an issued invoice is never deleted, a draft can
  // be, and then the old invoice simply has no replacement anymore).
  revisedFromId String?
  replacedById  String?

  // Immutable JSON snapshots captured AT ISSUE (architecture invariant 4).
  // Nullable only because a DRAFT has no snapshot yet — every ISSUED row has
  // all seven, and every issued read renders from them (never live relations).
  issuerSnapshot      Json?
  customerSnapshot    Json?
  contactSnapshot     Json?
  bankSnapshot        Json?
  signerSnapshot      Json?
  calculationSnapshot Json?
  templateSnapshot    Json?

  // Outstanding amount of this document after issue: equals grandTotal at
  // issue time (feature 05); feature 07 decrements it as payments land.
  remainingAfter Decimal @default(0) @db.Decimal(18, 2)

  // Feature 06: root-relative path of the OFFICIAL generated PDF
  // (invoices/organizations/{orgId}/{year}/{invoice-number}.pdf). Written once
  // by the PdfJob worker together with the InvoicePdf row; a null value means
  // "no file exists yet" — the UI says so instead of faking a download link.
  // The file itself is immutable (invariant 9): never re-rendered, never
  // overwritten — a revision produces a new invoice (and a new file).
  pdfPath String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile           InvoiceProfile   @relation(fields: [profileId], references: [id], onDelete: Restrict)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  projectReference  ProjectReference? @relation(fields: [projectReferenceId], references: [id], onDelete: SetNull)
  signer            Signer?          @relation(fields: [signerId], references: [id], onDelete: SetNull)
  bankAccount       BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdBy         user             @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy          user?            @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  revisedFrom       Invoice?         @relation("InvoiceRevisionParent", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisions         Invoice[]        @relation("InvoiceRevisionParent")
  replacedBy        Invoice?         @relation("InvoiceRevisionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacements      Invoice[]        @relation("InvoiceRevisionReplacement")
  items             InvoiceItem[]
  pdfJobs           PdfJob[]
  pdfs              InvoicePdf[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, customerId])
  @@index([organizationId, projectReferenceId])
  @@map("Invoice")
}

enum BillingMode {
  PERCENT
  MANUAL
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  position       Int
  description    String
  details        String? @db.Text
  quantity       Decimal @db.Decimal(18, 2)
  unit           String
  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  lineAmount     Decimal @db.Decimal(18, 2)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("InvoiceItem")
}

// ─── Feature 05: PDF job queue + official PDF record ──────────────────────
// Feature 05 only ENQUEUES a PENDING job at issue time and shows its honest
// status; the worker that runs the job and writes InvoicePdf is feature 06.

enum PdfJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model PdfJob {
  id           String       @id @default(cuid())
  invoiceId    String
  status       PdfJobStatus @default(PENDING)
  attempt      Int          @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime     @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Worker poll: WHERE status = PENDING ORDER BY createdAt.
  @@index([status, createdAt])
  @@index([invoiceId])
  @@map("PdfJob")
}

model InvoicePdf {
  id               String   @id @default(cuid())
  invoiceId        String
  version          Int
  storagePath      String
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  sha256           String
  templateVersion  String
  generatedById    String
  generatedAt      DateTime @default(now())
  isOfficial       Boolean  @default(false)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  generatedBy user    @relation("InvoicePdfGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@map("InvoicePdf")
}
